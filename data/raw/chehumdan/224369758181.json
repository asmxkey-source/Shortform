          "se-ff-nanummaruburi",
          "se-fs-",
          "se-l-default"
        ],
        "inline_styles": [
          "color:#000000;",
          "color:#000000;background-color:#ffffff;"
        ]
      }
    },
    {
      "type": "quotation",
      "text": "제품명\n정확한 용도\n올바른 사용방법\n주의사항\n신고·승인번호\n안전기준확인마크",
      "style": {
        "classes": [
          "se-ff-",
