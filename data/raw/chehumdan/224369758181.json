    },
    {
      "type": "text",
      "text": "입구는 안전 마개로 되어있어요.",
      "style": {
        "classes": [
          "se-ff-nanummaruburi",
          "se-fs-",
          "se-l-default"
        ],
        "inline_styles": [
          "color:#000000;",
