        ]
      }
    },
    {
      "type": "quotation",
      "text": "패스 스루 모드 & 기내 반입 걱정 끝!",
      "style": {
        "classes": [
          "se-ff-",
          "se-fs-",
          "se-l-quotation_line"
        ]
