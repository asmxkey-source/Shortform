          "se-l-default"
        ]
      }
    },
    {
      "type": "text",
      "text": "무엇보다 스마트폰 뒤에 붙여 사용하는\n마그네틱 방식인데, 슬림한 라인 덕분에\n장착했을 때 투박해 보이지 않습니다.",
      "style": {
        "classes": [
          "se-ff-nanummaruburi",
          "se-fs-",
          "se-l-default"
        ],
        "inline_styles": [
          "color:#000000;",
