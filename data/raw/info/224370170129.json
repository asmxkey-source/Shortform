    {
      "type": "sectionTitle",
      "text": "손해 볼 아이스크림 할인?",
      "style": {
        "classes": [
          "se-ff-nanummaruburi",
          "se-fs-fs34",
          "se-l-default"
        ],
        "has_bold": true
      }
