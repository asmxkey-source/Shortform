        ]
      }
    },
    {
      "type": "text",
      "text": "6가지 종류의 감과 배를 다양한 페어링으로\n맛보며 한 시간 반 정도의 행복한 시간을\n가졌습니다.",
      "style": {
        "classes": [
          "se-ff-nanummaruburi",
          "se-fs-",
          "se-l-default"
        ],
        "inline_styles": [
          "color:#000000;",
