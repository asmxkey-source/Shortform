        "classes": [
          "se-l-default"
        ]
      }
    },
    {
      "type": "text",
      "text": "즉흥과일클럽 엄청나게 푸짐하죠?\n팀원들의 배려로 껍질까지 같이 먹어보기로\n했습니다. 정말 감사했어요.",
      "style": {
        "classes": [
          "se-ff-nanummaruburi",
          "se-fs-",
          "se-l-default"
        ],
        "inline_styles": [
          "color:#000000;",
