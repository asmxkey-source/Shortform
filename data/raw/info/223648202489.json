          "se-l-default"
        ]
      }
    },
    {
      "type": "text",
      "text": "오늘의 주제는 바로\n'감놔라 배놔라'입니다.\n주인공인 감과 배\n추석이 생각나는 대표적인 과일이죠?",
      "style": {
        "classes": [
          "se-ff-nanummaruburi",
          "se-fs-",
          "se-l-default"
        ],
        "has_bold": true,
        "inline_styles": [
          "color:#000000;",
          "color:#000000;background-color:#ffffff;"
        ]
      }
    },
    {
      "type": "image",
      "count": 1,
