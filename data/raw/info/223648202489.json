        ]
      }
    },
    {
      "type": "text",
      "text": "오늘의 주인공 과일들과\n곁들여먹을 소스와 야채들",
      "style": {
        "classes": [
          "se-ff-nanummaruburi",
          "se-fs-",
          "se-l-default"
        ],
        "inline_styles": [
          "color:#000000;",
