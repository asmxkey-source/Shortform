          "se-l-default"
        ]
      }
    },
    {
      "type": "text",
      "text": "오늘의 주인공들입니다.",
      "style": {
        "classes": [
          "se-ff-nanummaruburi",
          "se-fs-",
          "se-l-default"
        ],
        "inline_styles": [
          "color:#000000;",
