          "se-l-default"
        ]
      }
    },
    {
      "type": "text",
      "text": "행사를 진행해주신 벗밭의 대표 가영님이\n과일을 하나하나 소개해 주셨어요.\n느긋하고 편안하게 일상과 거리를 두면서도\n호기심 가득하게 상 앞에 앉게 하는 목소리",
      "style": {
        "classes": [
          "se-ff-nanummaruburi",
          "se-fs-",
          "se-l-default"
        ],
        "inline_styles": [
          "color:#000000;",
