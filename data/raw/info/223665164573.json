          "se-l-default"
        ]
      }
    },
    {
      "type": "image",
      "count": 1,
      "style": {
        "classes": [
          "se-l-default"
        ]
      }
    },
    {
      "type": "text",
      "text": "유기농 오트밀, 유기농마스코바도,\n호박씨, 해바라기씨, 참깨, 검은깨, 아몬드,\n코코넛, 메이플시럽이 들어간\n고치그래놀라는 디트루키친의\n가장 클래식한 그래놀라에요.\n고소하고 바삭한 맛이 특징이에요.",
      "style": {
        "classes": [
          "se-ff-nanummaruburi",
          "se-fs-",
          "se-l-default"
        ],
        "inline_styles": [
          "color:#000000;",
