    {
      "type": "text",
      "text": "합정에서 혼밥하는데 집밥 그리울 때 _by링키\n90세 할머니의 손맛\n정갈하고 맛있는 백반집\n'백세식당'",
      "style": {
        "classes": [
          "se-ff-nanummaruburi",
          "se-fs-fs15",
          "se-fs-fs34",
          "se-l-default"
        ],
        "has_bold": true,
        "inline_styles": [
          "color:#0095e9;",
          "color:#0095e9;background-color:#ffffff;",
          "color:#444444;background-color:#ffffff;"
        ]
      }
    },
    {
      "type": "horizontalLine",
