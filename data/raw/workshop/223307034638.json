          "se-l-default"
        ]
      }
    },
    {
      "type": "text",
      "text": "원장선생님인 달리선생님께서 상담해주셨는데,\n펫 셰이밍 안 하는 분위기,\n여성 대표 + 여성코치진이 다수라는 라는 점,\nsnpe와 웨이트, 요가등등 가능한 점이 이 저에게 많은 어필이 되었습니다.",
      "style": {
        "classes": [
          "se-ff-nanummaruburi",
          "se-fs-",
          "se-l-default"
        ],
        "has_bold": true,
        "inline_styles": [
